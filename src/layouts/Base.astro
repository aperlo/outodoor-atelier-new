---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { leadFields, trackingFields } from '../lib/leads';
import { img, Q } from '../data/content';
import Icon from '../components/Icon.astro';
import Esempio from '../components/Esempio.astro';
import config from '../data/config.json';

interface Props {
  title: string;
  description: string;
  overHero?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Nome della pagina, usato dagli stili (es. "collezione"). */
  page?: string;
  /** Invito fisso ai campioni in basso a destra. */
  samplesCta?: boolean;
}
const { title, description, overHero = false, noindex = false, jsonLd, page, samplesCta = true } = Astro.props;
const maxSamples = config.sample_service.max_samples;
// Gli indirizzi pubblici non hanno estensione: /collezione, non /collezione.html.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site).href;
const fullTitle = `${title} | ${site.name}`;
const robots = !site.indexable || noindex ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={img(Q.heroVilla, 1200)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#172820" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-page={page}>
    <a href="#contenuto" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:bg-forest focus:px-4 focus:py-2 focus:text-sand">Vai al contenuto</a>
    <Header overHero={overHero} />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />

    <!-- Barra di confronto: compare quando ci sono modelli selezionati. -->
    <div data-compare-tray hidden class="fixed bottom-4 left-1/2 z-40 flex -translate-x-1/2 items-center gap-4 bg-forest-deep px-5 py-3 text-sm text-sand shadow-[0_12px_36px_rgb(23_40_32/0.3)]">
      <span><span data-compare-count class="font-mono">0</span>/3 modelli da confrontare</span>
      <button type="button" data-compare-clear class="text-stone underline">Svuota</button>
      <a href="/confronta" class="font-semibold text-brass underline">Confronta</a>
    </div>

    {samplesCta && (
      <a href="/campioni" class="samples-cta" data-samples-cta>
        <Icon name="box" size={18} />
        <span data-samples-cta-label>
          <span class="hidden sm:inline">Richiedi {maxSamples} campioni gratuiti</span>
          <span class="sm:hidden">Campioni gratuiti</span>
        </span>
        <span class="samples-cta-count font-mono text-xs" data-samples-cta-count hidden></span>
      </a>
    )}

    <!-- Mini-carrello a scomparsa (src/scripts/cart-drawer.ts). -->
    <div class="cart-drawer" data-cart-drawer data-open="false" inert>
      <div class="cart-backdrop" data-cart-close></div>
      <aside class="cart-panel" data-cart-panel role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" tabindex="-1">
        <div class="flex items-center justify-between border-b border-stone-line px-6 py-5">
          <h2 id="cart-drawer-title" class="text-2xl">Il tuo progetto</h2>
          <button type="button" class="size-10 text-2xl leading-none" data-cart-close aria-label="Chiudi il carrello">×</button>
        </div>
        <p class="px-6 pt-4 text-xs text-moss">Prezzi IVA esclusa · spedizione e IVA calcolate nel riepilogo con il CAP</p>
        <ul class="flex-1 overflow-y-auto px-6" data-cart-lines></ul>
        <div class="flex-1 px-6 py-10 text-center" data-cart-empty hidden>
          <p class="font-heading text-xl">Il carrello è vuoto.</p>
          <p class="mt-2 text-sm text-moss">Inizia dal configuratore o scegli una superficie.</p>
          <a href="/progetta" class="btn-forest mt-6">Progetta il tuo spazio</a>
        </div>
        <div class="border-t border-stone-line bg-white px-6 py-5" data-cart-foot hidden>
          <div class="flex justify-between text-sm"><span class="text-moss">Subtotale merce (IVA escl.)<Esempio /></span><span class="font-mono" data-cart-subtotal></span></div>
          <a href="/carrello" class="btn-forest mt-4 w-full">Riepilogo e richiesta d'ordine</a>
          <button type="button" class="mt-3 w-full text-center text-sm text-moss underline" data-cart-close>Continua a esplorare</button>
        </div>
      </aside>
    </div>

    <!-- Definizione del modulo per Netlify Forms: elenca tutti i campi che il sito può inviare. -->
    <form name={site.formName} data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input name="bot-field" />
      <input name="kind" />
      {[...leadFields, ...trackingFields].map((f) => <input name={f} />)}
      <input name="privacy" />
      <textarea name="payload"></textarea>
    </form>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
