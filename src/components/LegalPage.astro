---
// Cornice comune alle pagine legali. Finché i dati societari non sono compilati in
// src/config/site.ts, la pagina mostra l'avviso di bozza e resta esclusa dai motori di ricerca.
import Base from '../layouts/Base.astro';
import { site, companyReady } from '../config/site';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
const c = site.company;
---
<Base title={title} description={description} noindex={!companyReady}>
  <section class="bg-ivory pb-10 pt-32">
    <div class="wrap">
      <p class="eyebrow text-brass-ink">Informazioni legali</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{title}</h1>
      <p class="mt-3 text-sm text-moss">Ultimo aggiornamento: {updated}</p>
    </div>
  </section>
  <div class="wrap py-12">
    {!companyReady && (
      <p class="mb-10 border border-brass bg-white p-5 text-sm leading-relaxed">
        <b>Bozza da completare.</b> Mancano i dati del titolare (ragione sociale, sede, partita IVA, contatti) e la revisione di un legale. Questa pagina non va considerata definitiva e non è indicizzata.
      </p>
    )}
    <div class="max-w-3xl space-y-8 leading-relaxed [&_h2]:mb-3 [&_h2]:text-2xl [&_li]:ml-5 [&_li]:list-disc [&_p+p]:mt-3 [&_ul]:space-y-1.5">
      <section>
        <h2>Titolare</h2>
        {companyReady ? (
          <p>{c.legalName}{c.address && `, ${c.address}`}{c.vatId && ` · P. IVA ${c.vatId}`}{c.rea && ` · REA ${c.rea}`}{c.email && ` · ${c.email}`}{c.pec && ` · PEC ${c.pec}`}</p>
        ) : (
          <p>[Ragione sociale] · [Sede legale] · [Partita IVA] · [REA] · [Email] · [PEC]</p>
        )}
      </section>
      <slot />
    </div>
  </div>
</Base>
