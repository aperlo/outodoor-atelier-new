---
import Icon from './Icon.astro';
import Esempio from './Esempio.astro';
import config from '../data/config.json';
import { site } from '../config/site';
import { useLabels, availabilityLabels, resize } from '../data/content';
import { eur } from '../lib/format';
import type { Product } from '../lib/quote';

interface Props {
  p: Product;
  compact?: boolean;
}
const { p, compact = false } = Astro.props;
const uses = p.uses.map((u) => useLabels[u]);
const searchText = `${p.name} ${p.tagline} ${p.appearance} ${uses.join(' ')}`.toLowerCase();
---
<article
  class="flex flex-col border border-stone-line bg-white"
  data-card
  data-text={searchText}
  data-height={p.height_mm}
  data-uses={p.uses.join(' ')}
  data-appearance={p.appearance}
  data-tone={p.tone}
  data-softness={p.softness}
  data-drainage={p.drainage}
  data-collection={p.collection}
  data-price={p.price_m2}
>
  <a href={`/superfici/${p.slug}`} class="relative block aspect-[4/3] overflow-hidden bg-ivory">
    <img src={resize(p.image, 700)} alt={`Superficie ${p.name}`} loading="lazy" decoding="async" width="700" height="525" class="size-full object-cover transition-transform duration-700 hover:scale-105" />
    <span class="absolute left-3 top-3 bg-sand px-2 py-1 font-mono text-[11px]">{p.height_mm} mm</span>
    {config.demo_values && <span class="absolute bottom-3 left-3 bg-forest-deep/80 px-2 py-1 text-[10px] uppercase tracking-[0.14em] text-sand">Foto di ambientazione</span>}
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="eyebrow text-brass-ink">{uses.slice(0, 2).join(' · ')}</p>
    <h3 class="mt-2 text-2xl"><a href={`/superfici/${p.slug}`}>{p.name}</a></h3>
    {!compact && <p class="mt-1 text-sm text-moss">{p.tagline}</p>}
    <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
      <dt class="text-moss">Aspetto</dt><dd>{p.appearance}</dd>
      <dt class="text-moss">Morbidezza</dt><dd class="capitalize">{p.softness}</dd>
    </dl>
    <div class="mt-auto pt-5">
      <p class="font-mono text-lg">{eur(p.price_m2)}<span class="text-xs text-moss">/m² + IVA</span><Esempio /></p>
      <p class="font-mono text-xs text-moss">{eur(p.price_m2 * (1 + config.vat_rate))}/m² IVA incl.</p>
      <p class="mt-2 text-xs text-moss">{site.showAvailability ? availabilityLabels[p.availability] : 'Su ordinazione'}</p>
      <div class="mt-4 flex gap-2">
        <a href={`/superfici/${p.slug}`} class="btn-forest flex-1 !px-4 !py-3">Scopri</a>
        <button type="button" class="icon-btn" data-sample={p.slug} data-name={p.name} aria-pressed="false" aria-label={`Aggiungi ${p.name} al box campioni`} title="Box campioni">
          <Icon name="box" />
        </button>
        <button type="button" class="icon-btn" data-compare={p.slug} aria-pressed="false" aria-label={`Confronta ${p.name}`} title="Confronta">
          <Icon name="compare" />
        </button>
      </div>
    </div>
  </div>
</article>
