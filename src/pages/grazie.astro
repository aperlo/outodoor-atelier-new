---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Richiesta ricevuta" description="Abbiamo ricevuto la tua richiesta." noindex>
  <section class="wrap flex min-h-[70vh] flex-col items-start justify-center pb-20 pt-36">
    <span class="flex size-12 items-center justify-center bg-forest text-sand"><Icon name="check" size={22} /></span>
    <p class="eyebrow mt-6 text-brass-ink">Richiesta ricevuta</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Grazie, ci siamo.</h1>
    <p class="mt-4 max-w-xl leading-relaxed text-moss">Abbiamo ricevuto la tua richiesta. Un consulente la legge e ti risponde all'indirizzo email che hai indicato.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/collezione" class="btn-forest">Torna alla collezione</a>
      <a href="/" class="btn-line">Home</a>
    </div>
  </section>
</Base>
