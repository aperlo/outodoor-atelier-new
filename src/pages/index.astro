---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import DemoNote from '../components/DemoNote.astro';
import Reviews from '../components/Reviews.astro';
import FaqList from '../components/FaqList.astro';
import { products, config } from '../lib/quote';
import { site } from '../config/site';
import { img, Q, worlds, marquee, projects, sectors, sectorGroups, tagline, P } from '../data/content';

const featured = [...products].sort((a, b) => Number(b.featured) - Number(a.featured)).slice(0, 8);
const difference = [
  ['Struttura della fibra', 'Sezione, spessore e resilienza del filo determinano come il manto si rialza dopo il calpestio.'],
  ['Aspetto multidirezionale', "Fibre orientate in più direzioni: nessun 'verso' visibile, luce uniforme da ogni angolo."],
  ['Qualità dei materiali', 'Polimeri, pigmenti e supporto da filiera italiana tracciabile, dichiarati dal produttore.'],
  ['Documentazione di sicurezza', `Schede tecniche e test pubblicati solo quando forniti e verificati da ${P}.`],
  ['Durata e manutenzione', 'Spazzolatura periodica, risciacquo: indicazioni di cura specifiche per ogni modello.'],
  ['Riciclabilità', 'Informazioni di fine vita comunicate solo dove documentate dal produttore.'],
];
const steps = [
  { n: '01', icon: 'box', t: 'Campioni gratuiti', d: 'Fino a 4 campioni fisici a casa tua: tocca la fibra, valuta colore e morbidezza alla luce del tuo spazio.', to: '/campioni', cta: 'Scegli i campioni' },
  { n: '02', icon: 'file', t: 'Taglio su misura & consegna', d: 'Formati pronti 5×2 e 10×2 m o taglio sulle tue misure, anche per pochi metri quadri. Spedizione calcolata su peso e CAP.', to: '/progetta', cta: 'Calcola il progetto' },
  { n: '03', icon: 'check', t: 'Posa: da solo o con un professionista', d: 'Stima indicativa della posa per CAP e richiesta di sopralluogo. Disponibilità confermata solo con un partner locale verificato.', to: '/progetta?step=5', cta: 'Stima la posa' },
] as const;
// Capitoli della home: la sequenza narrativa, nell'ordine in cui si leggono.
const chapters = [
  { n: 'I', id: 'apertura', title: "L'arte di vivere all'aperto" },
  { n: 'II', id: 'prato-vero', title: 'Il prato vero, ogni settimana' },
  { n: 'III', id: 'mondi', title: 'Ogni spazio ha la sua natura' },
  { n: 'IV', id: 'collezione', title: 'La collezione' },
  { n: 'V', id: 'differenza', title: "L'esperienza della differenza" },
  { n: 'VI', id: 'reimmaginato', title: 'Il tuo spazio, reimmaginato' },
];
// Confronto concreto tra prato vero e sintetico: nessuna cifra, solo il lavoro che cambia.
const chores = [
  ['Acqua in estate', 'Irrigazione quasi ogni sera', 'Una sciacquata quando serve'],
  ['Taglio', 'Ogni settimana, da aprile a ottobre', 'Mai'],
  ['Concime e diserbo', "Più volte l'anno", 'Mai'],
  ['Chiazze', 'Da riseminare', 'Il verde resta uniforme'],
  ['Cane e pioggia', 'Fango in casa', 'Si risciacqua in pochi minuti'],
  ['Ombra e terrazzi', 'Cresce male o per niente', 'Si posa anche su piastrelle'],
];
const pros = ['Architetti', 'Paesaggisti', 'Installatori', 'Hospitality', 'Developer', 'Enti pubblici'];
const worldSpan = ['lg:col-span-7 lg:row-span-2', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-12'];
---
<Base
  title="Erba sintetica premium Made in Italy"
  description="The Outdoor Atelier: superfici premium in erba sintetica per giardini, terrazze, rooftop e piscine. Progetta il tuo spazio con preventivo trasparente."
  overHero
  jsonLd={{ '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: Astro.site?.href, slogan: site.claim }}
>
  <!-- Apertura -->
  <section id="apertura" class="relative isolate flex min-h-[88svh] items-end overflow-hidden bg-forest-deep text-sand">
    <img src={img(Q.heroVilla, 2200)} alt="Villa contemporanea con giardino e piscina" fetchpriority="high" class="hero-img absolute inset-0 -z-10 size-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-forest-deep/90 via-forest-deep/35 to-forest-deep/45"></div>
    <div class="wrap pb-16 pt-32 sm:pb-20">
      <p class="eyebrow text-brass">Capitolo I · L'arte di vivere all'aperto</p>
      <h1 class="mt-5 text-5xl leading-[1.02] sm:text-7xl lg:text-8xl">365 giorni di verde.<br /><em class="font-normal">Le sere d'estate tornano tue.</em></h1>
      <p class="mt-5 max-w-xl text-base text-stone sm:text-lg">Erba sintetica italiana di fascia alta: si posa una volta e resta verde tutto l'anno. Prima di scegliere, tocca {config.sample_service.max_samples} campioni a casa tua, gratis.</p>
      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
        <a href="/campioni" class="btn-brass"><Icon name="box" size={16} /> Richiedi {config.sample_service.max_samples} campioni gratuiti</a>
        <a href="/progetta" class="eyebrow inline-flex items-center gap-2 border-b border-sand/50 pb-1 text-sand/90 hover:text-sand">Oppure calcola il preventivo <Icon name="arrow" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- Punti di forza -->
  <div class="marquee border-b border-stone-line bg-ivory py-4" aria-hidden="true">
    <div>
      {[...marquee, ...marquee].map((m) => (
        <span class="eyebrow flex items-center gap-10 whitespace-nowrap text-moss">{m}<span class="text-brass">✦</span></span>
      ))}
    </div>
  </div>

  <!-- Indice dei capitoli -->
  <nav aria-label="Capitoli" class="wrap overflow-x-auto py-6">
    <ol class="flex min-w-max gap-8 text-sm">
      {chapters.map((c) => (
        <li><a href={`#${c.id}`} class="flex items-baseline gap-2 text-moss hover:text-forest-deep"><span class="font-heading text-lg text-brass-ink">{c.n}</span>{c.title}</a></li>
      ))}
    </ol>
  </nav>

  <!-- Il prato vero -->
  <section id="prato-vero" class="wrap pb-16 pt-10 lg:pb-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-brass-ink">Capitolo II · Il prato vero, ogni settimana</p>
        <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Bellissimo. Finché non tocca a te curarlo.</h2>
        <p class="mt-5 leading-relaxed text-moss">Un giardino o un terrazzo verde chiede tempo ogni settimana, e acqua ogni sera d'estate. Ecco cosa cambia, voce per voce.</p>
        <p class="mt-5 text-sm leading-relaxed text-moss">Onestà prima di tutto: anche l'erba sintetica va spazzolata ogni tanto, e al sole pieno d'agosto si scalda. Te lo diciamo prima.</p>
      </div>
      <div class="overflow-x-auto lg:col-span-7">
        <table class="w-full min-w-[520px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-forest-deep text-left">
              <th class="py-3 pr-4 font-semibold"></th>
              <th class="py-3 pr-4 font-semibold">Prato naturale</th>
              <th class="py-3 font-semibold">Erba sintetica</th>
            </tr>
          </thead>
          <tbody>
            {chores.map(([what, natural, synthetic]) => (
              <tr class="border-b border-stone-line">
                <td class="py-3 pr-4 text-moss">{what}</td>
                <td class="py-3 pr-4">{natural}</td>
                <td class="py-3 font-semibold text-forest">{synthetic}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <a href="/campioni" class="btn-forest mt-6"><Icon name="box" size={16} /> Tocca la differenza: {config.sample_service.max_samples} campioni gratis</a>
      </div>
    </div>
  </section>

  <!-- Quattro mondi -->
  <section id="mondi" class="wrap border-t border-stone-line py-20 lg:py-28">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow text-brass-ink">Capitolo III · Quattro mondi</p>
        <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Ogni spazio ha la sua natura.</h2>
      </div>
      <p class="max-w-xl leading-relaxed text-moss">Non vendiamo un rotolo d'erba: progettiamo la trasformazione del tuo spazio. Scegli il mondo che ti somiglia e trova la superficie pensata per viverlo.</p>
    </div>
    <div class="mt-12 grid gap-4 lg:grid-cols-12 lg:grid-rows-2">
      {worlds.map((w, i) => (
        <a href={w.href} class={`group relative isolate flex min-h-64 items-end overflow-hidden bg-forest-deep p-7 text-sand ${worldSpan[i]} ${i === 0 ? 'lg:min-h-[34rem]' : ''}`}>
          <img src={img(w.image, 1400)} alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-forest-deep/85 via-forest-deep/20 to-transparent"></div>
          <div class="flex w-full items-end justify-between gap-6">
            <div>
              <p class="font-mono text-xs text-brass">0{i + 1}</p>
              <h3 class="mt-2 text-3xl">{w.title}</h3>
              <p class="mt-1 text-sm text-stone">{w.line}</p>
            </div>
            <span class="flex size-11 shrink-0 items-center justify-center border border-sand/50"><Icon name="arrow" /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Collezione -->
  <section id="collezione" class="bg-ivory py-20 lg:py-28">
    <div class="wrap">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow text-brass-ink">Capitolo IV · La collezione</p>
          <h2 class="mt-3 max-w-2xl text-4xl leading-tight sm:text-5xl">Superfici scelte come si sceglie un materiale d'architettura.</h2>
        </div>
        <a href="/collezione" class="btn-line shrink-0">Esplora tutta la collezione <Icon name="arrow" size={16} /></a>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => <ProductCard p={p} compact />)}
      </div>
      <DemoNote class="mt-6" />
    </div>
  </section>

  <!-- La differenza -->
  <section id="differenza" class="wrap grid gap-12 py-20 lg:grid-cols-2 lg:items-center lg:py-28">
    <figure class="relative">
      <img src={img(Q.macro, 1600)} alt="Dettaglio ravvicinato della fibra di un manto sintetico" loading="lazy" decoding="async" class="aspect-[4/5] w-full object-cover" />
      <figcaption class="eyebrow absolute bottom-4 left-4 bg-sand px-3 py-2 text-moss">Macro · dettaglio fibra</figcaption>
    </figure>
    <div>
      <p class="eyebrow text-brass-ink">Capitolo V · L'esperienza della differenza</p>
      <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Progettato per sembrare naturale. Ingegnerizzato per durare.</h2>
      <p class="mt-5 leading-relaxed text-moss">La differenza tra una superficie premium europea e un'alternativa low-cost non si vede in foto: si sente sotto i piedi, si nota dopo tre estati, si legge nella documentazione.</p>
      <dl class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {difference.map(([t, d]) => (
          <div class="border-t border-stone-line pt-4">
            <dt class="font-semibold">{t}</dt>
            <dd class="mt-1 text-sm leading-relaxed text-moss">{d}</dd>
          </div>
        ))}
      </dl>
      <a href="/qualita" class="btn-line mt-9">Qualità e manifattura <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <!-- Visualizzatore -->
  <section id="reimmaginato" class="bg-forest-deep py-20 text-sand lg:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow text-brass">Capitolo VI · Il tuo spazio, reimmaginato</p>
        <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Guarda il tuo spazio in un modo diverso.</h2>
        <p class="mt-5 leading-relaxed text-stone">Carica una foto del tuo giardino, balcone o terrazzo, disegna l'area da trasformare e applica le texture della collezione. Confronta prima e dopo con un cursore, poi calcola il preventivo o chiedi una consulenza.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/visualizzatore" class="btn-brass"><Icon name="upload" size={16} /> Carica la tua foto</a>
          <a href="/progetta" class="btn-line-light">Configura il progetto</a>
        </div>
      </div>
      <div>
        <div class="relative aspect-[4/3] select-none overflow-hidden" data-ba>
          <img src={img(Q.patio, 1400)} alt="Terrazza prima della posa" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
          <div class="ba-after absolute inset-0">
            <img src={img(Q.patio, 1400)} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
            <div class="absolute inset-0" style={`background-image:url(${img(Q.macro, 600)});background-size:260px;clip-path:polygon(0% 72%,100% 64%,100% 100%,0% 100%)`}></div>
          </div>
          <div class="ba-line pointer-events-none absolute inset-y-0 w-px bg-sand">
            <span class="ba-knob absolute left-1/2 top-1/2 flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-sand text-sm text-forest-deep shadow-[0_6px_20px_rgb(23_40_32/0.35)]" aria-hidden="true">↔</span>
          </div>
          <span class="eyebrow pointer-events-none absolute left-4 top-4 bg-forest-deep/80 px-2 py-1">Prima</span>
          <span class="eyebrow pointer-events-none absolute right-4 top-4 bg-brass px-2 py-1 text-forest-deep">Dopo</span>
          <input type="range" min="0" max="100" value="50" aria-label="Sposta il confine tra prima e dopo" />
        </div>
        <p class="mt-3 text-xs text-stone">Trascina il cursore. Anteprima illustrativa: sovrapposizione manuale della texture, nessuna elaborazione AI. Con la tua foto: <a href="/visualizzatore" class="underline">visualizzatore completo</a>.</p>
      </div>
    </div>
  </section>

  <!-- Esperienza completa -->
  <section class="wrap py-20 lg:py-28">
    <p class="eyebrow text-brass-ink">L'esperienza completa</p>
    <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Dal primo campione all'ultima giunta.</h2>
    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {steps.map((s) => (
        <div class="flex flex-col border border-stone-line bg-white p-8">
          <div class="flex items-center justify-between text-brass-ink">
            <span class="font-mono text-sm">{s.n}</span>
            <Icon name={s.icon} size={28} />
          </div>
          <h3 class="mt-8 text-2xl">{s.t}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-moss">{s.d}</p>
          <a href={s.to} class="eyebrow mt-6 inline-flex items-center gap-2 border-b border-current pb-1 self-start">{s.cta} <Icon name="arrow" size={14} /></a>
        </div>
      ))}
    </div>
  </section>

  <!-- Ambientazioni -->
  <section class="bg-ivory py-20 lg:py-28">
    <div class="wrap">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow text-brass-ink">Ispirazione</p>
          <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Ambientazioni.</h2>
        </div>
        <a href="/progetti" class="eyebrow border-b border-current pb-1">Tutte le ambientazioni →</a>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.slice(0, 6).map((p) => (
          <a href={`/superfici/${p.product}`} class="group block">
            <div class="aspect-[4/3] overflow-hidden"><img src={img(p.image, 900)} alt={p.title} loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
            <p class="mt-3 font-heading text-xl">{p.title}</p>
            <p class="eyebrow mt-1 text-moss">{p.place} · vedi la superficie →</p>
          </a>
        ))}
      </div>
      <p class="mt-6 text-xs text-moss">Immagini di ambientazione a scopo illustrativo: non rappresentano installazioni realizzate.</p>
    </div>
  </section>

  <!-- Recensioni (esempi etichettati finché non ci sono recensioni vere) -->
  <Reviews limit={3} tone="light" />

  <!-- Settori dedicati -->
  <section class="wrap py-20 lg:py-28">
    <p class="eyebrow text-brass-ink">Oltre il giardino</p>
    <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Settori dedicati.</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-moss">Spazi pubblici, allestimenti di prestigio, interni e sport light: competenze e superfici dedicate.</p>
    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {sectorGroups.map((g) => {
        const list = sectors.filter((s) => s.group === g.id);
        return (
          <div class="relative isolate overflow-hidden bg-forest-deep p-8 text-sand">
            <img src={img(list[0].image, 1000)} alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-10 size-full object-cover opacity-35" />
            <p class="eyebrow text-brass">{g.lead}</p>
            <h3 class="mt-3 text-3xl">{g.label}</h3>
            <ul class="mt-6 space-y-3 text-sm">
              {list.map((s) => (
                <li><a href={`/settori/${s.slug}`} class="flex items-center justify-between border-b border-sand/20 pb-3 hover:text-brass">{s.nav}<Icon name="arrow" size={14} /></a></li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Domande frequenti -->
  <section id="domande" class="wrap grid gap-10 py-20 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-4">
      <p class="eyebrow text-brass-ink">Domande frequenti</p>
      <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Le risposte oneste.</h2>
      <p class="mt-5 leading-relaxed text-moss">Anche sui lati meno comodi dell'erba sintetica, prima che tu scelga.</p>
      <a href="/domande-frequenti" class="eyebrow mt-6 inline-flex items-center gap-2 border-b border-current pb-1">Tutte le domande <Icon name="arrow" size={14} /></a>
    </div>
    <div class="lg:col-span-8">
      <FaqList homeOnly />
    </div>
  </section>

  <!-- Professionisti -->
  <section class="bg-ivory py-20 lg:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow text-brass-ink">Per i professionisti</p>
        <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">Un partner tecnico per chi progetta lo spazio esterno.</h2>
        <p class="mt-5 leading-relaxed text-moss">Architetti, paesaggisti, installatori, developer e operatori hospitality: documentazione tecnica, campionature di studio, quotazioni di cantiere e un consulente dedicato.</p>
        <a href="/professionisti" class="btn-forest mt-8">Entra nella rete professionisti <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid grid-cols-2 gap-px bg-stone-line sm:grid-cols-3">
        {pros.map((p) => (
          <div class="bg-white p-6">
            <p class="font-heading text-xl">{p}</p>
            <p class="eyebrow mt-2 text-moss">Percorso dedicato</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chiusura -->
  <section class="relative isolate overflow-hidden bg-forest-deep py-28 text-center text-sand">
    <img src={img(Q.villaPool, 2000)} alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-10 size-full object-cover opacity-40" />
    <div class="wrap">
      <h2 class="mx-auto max-w-3xl text-4xl leading-tight sm:text-6xl">Il tuo prossimo progetto all'aperto inizia qui.</h2>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/progetta" class="btn-brass">Progetta il tuo spazio <Icon name="arrow" size={16} /></a>
        <a href="/campioni" class="btn-line-light">Richiedi i campioni</a>
      </div>
    </div>
  </section>
</Base>
