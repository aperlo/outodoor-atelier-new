---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { img, Q, daP } from '../data/content';

const points = [
  { id: 'manifattura', t: 'Manifattura italiana', d: `Superfici prodotte in Italia ${daP}, con una lunga esperienza nelle superfici sintetiche.` },
  { id: 'documentazione', t: 'Documentazione dal produttore', d: 'Schede tecniche, istruzioni di posa e dichiarazioni sono fornite dal produttore. Non pubblichiamo certificazioni non verificate.' },
  { id: 'scelta', t: 'Scelta guidata', d: 'Campioni, confronto e consulenza: per scegliere sulla base del tuo spazio, non di una foto.' },
  { id: 'prezzi', t: 'Prezzi trasparenti', d: 'Prezzo al m² IVA esclusa e inclusa, spedizione e accessori chiari prima della richiesta.' },
];
---
<Base
  title="Qualità Made in Italy"
  description="Manifattura italiana, filiera e documentazione: cosa rende premium una superficie sintetica."
>
  <PageHero
    overline="Qualità"
    title="Il dettaglio è dove si vede il lusso."
    intro="Fibra, supporto, densità, posa: le scelte che fanno durare un prato sintetico nel tempo."
    image={img(Q.macro)}
  />
  <section class="wrap grid gap-x-12 py-16 sm:grid-cols-2">
    {points.map((p, i) => (
      <div id={p.id} class="border-t border-stone-line py-9">
        <span class="font-mono text-xs text-brass-ink">0{i + 1}</span>
        <h2 class="mt-3 text-3xl">{p.t}</h2>
        <p class="mt-3 max-w-md leading-relaxed text-moss">{p.d}</p>
      </div>
    ))}
  </section>
  <div class="wrap flex flex-col gap-3 pb-20 sm:flex-row">
    <a href="/campioni" class="btn-forest">Richiedi i campioni</a>
    <a href="/collezione" class="btn-line">Collezione <Icon name="arrow" size={16} /></a>
  </div>
</Base>
