---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import { img, Q } from '../data/content';
import { site, companyReady } from '../config/site';

const c = site.company;
---
<Base
  title="Contatti — consulenza gratuita"
  description="Parla con un consulente The Outdoor Atelier per il tuo giardino, terrazza o progetto."
>
  <PageHero overline="Contatti" title="Raccontaci il tuo spazio." intro="Un consulente ti risponde senza impegno." />
  <div class="wrap grid gap-12 py-14 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <LeadForm
        kind="consultation"
        submitLabel="Richiedi la consulenza"
        fields={[
          { name: 'name', label: 'Nome e cognome', required: true, half: true },
          { name: 'email', label: 'Email', type: 'email', required: true, half: true },
          { name: 'phone', label: 'Telefono', type: 'tel', half: true },
          { name: 'cap', label: 'CAP', half: true },
          { name: 'message', label: 'Raccontaci il tuo spazio', textarea: true },
        ]}
      />
    </div>
    <aside class="lg:col-span-5">
      <img src={img(Q.villaPool, 900)} alt="" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
      {companyReady ? (
        <dl class="mt-6 space-y-2 text-sm">
          <div><dt class="eyebrow text-brass-ink">Società</dt><dd class="mt-1">{c.legalName}{c.address && ` · ${c.address}`}</dd></div>
          {c.email && <div><dt class="eyebrow mt-4 text-brass-ink">Email</dt><dd class="mt-1 select-all">{c.email}</dd></div>}
          {c.phone && <div><dt class="eyebrow mt-4 text-brass-ink">Telefono</dt><dd class="mt-1 select-all">{c.phone}</dd></div>}
        </dl>
      ) : (
        <p class="mt-6 text-sm leading-relaxed text-moss">Recapiti e dati societari verranno pubblicati al lancio. Nel frattempo il modulo è il canale per scriverci.</p>
      )}
    </aside>
  </div>
</Base>
