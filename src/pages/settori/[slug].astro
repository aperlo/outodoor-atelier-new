---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import { products } from '../../lib/quote';
import { img, sectors, sectorGroups, type Sector } from '../../data/content';

export function getStaticPaths() {
  return sectors.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Sector };
const matching = products.filter((p) => p.uses.some((u) => s.uses.includes(u)));
const recommended = (matching.length ? matching : products.slice(0, 3)).slice(0, 6);
const dedicated = s.group !== 'living';
const overline = sectorGroups.find((g) => g.id === s.group)?.label ?? 'Ambienti';
---
<Base
  title={s.seoTitle}
  description={s.intro}
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebPage', name: s.seoTitle, description: s.intro }}
>
  <PageHero overline={overline} title={s.title} intro={s.intro} image={img(s.image)}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={`/progetta?ambiente=${s.env}`} class="btn-brass">Progetta il tuo spazio</a>
      <a href="/campioni" class="btn-line-light">Richiedi i campioni</a>
    </div>
  </PageHero>

  <section class="wrap grid gap-px py-16 sm:grid-cols-3">
    {s.points.map((point, i) => (
      <div class="border-t border-stone-line py-6 sm:pr-8">
        <span class="font-mono text-xs text-brass-ink">0{i + 1}</span>
        <p class="mt-3 font-heading text-2xl leading-snug">{point}</p>
      </div>
    ))}
  </section>

  <section class="bg-ivory py-16">
    <div class="wrap">
      <h2 class="text-3xl sm:text-4xl">Superfici consigliate</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {recommended.map((p) => <ProductCard p={p} />)}
      </div>
    </div>
  </section>

  {dedicated && (
    <section class="bg-forest-deep py-20 text-sand">
      <div class="wrap grid gap-12 lg:grid-cols-2">
        <div>
          <p class="eyebrow text-brass">Progetti dedicati</p>
          <h2 class="mt-3 text-4xl leading-tight">Un consulente per il tuo progetto.</h2>
          <p class="mt-5 max-w-lg leading-relaxed text-stone">Metrature importanti, capitolati, requisiti tecnici e tempistiche: li valutiamo insieme, con documentazione fornita dal produttore.</p>
        </div>
        <LeadForm
          dark
          kind="trade_quote"
          submitLabel="Richiedi un preventivo dedicato"
          payload={{ sector: s.slug }}
          fields={[
            { name: 'name', label: 'Nome', required: true, half: true },
            { name: 'company', label: 'Ente / azienda', half: true },
            { name: 'email', label: 'Email', type: 'email', required: true, half: true },
            { name: 'phone', label: 'Telefono', type: 'tel', half: true },
            { name: 'message', label: 'Metrature, luogo, tempistiche', textarea: true },
          ]}
        />
      </div>
    </section>
  )}

  <section class="wrap py-16">
    <p class="eyebrow text-brass-ink">Altri ambienti</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {sectors.filter((x) => x.slug !== s.slug).map((x) => <a href={`/settori/${x.slug}`} class="chip">{x.nav}</a>)}
    </div>
  </section>
</Base>
