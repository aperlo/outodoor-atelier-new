---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata" description="La pagina richiesta non esiste." noindex samplesCta={false}>
  <section class="wrap flex min-h-[70vh] flex-col items-start justify-center pb-20 pt-36">
    <p class="eyebrow text-brass-ink">Errore 404</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Questa pagina non esiste.</h1>
    <p class="mt-4 max-w-xl text-moss">L'indirizzo potrebbe essere cambiato. Riparti dalla collezione o dalla home.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/collezione" class="btn-forest">Vai alla collezione</a>
      <a href="/" class="btn-line">Torna alla home</a>
    </div>
  </section>
</Base>
